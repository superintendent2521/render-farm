ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=replace-with-at-least-32-random-bytes
PUBLIC_URL=https://farm.example.com
SECURE_COOKIES=true
EXPOSURE_MODE=cloudflare
TUNNEL_METRICS_URL=http://cloudflared:2000/ready
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-tunnel-token
LAN_BIND=127.0.0.1
LAN_PORT=8443
STORAGE_BACKEND=local
BLENDER_VERSION=4.2.5
